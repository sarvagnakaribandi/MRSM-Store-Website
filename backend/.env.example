# ==============================================================================
# MR SM Multi Brand Store — Backend Environment Configuration Example
# ==============================================================================

# Port the Express REST API runs on
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=development

# Allowed Frontend Origin for CORS
CLIENT_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# MongoDB Connection String
# ------------------------------------------------------------------------------
# Option A: MongoDB Atlas (Cloud Database - Recommended)
# Example: MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/mrsm_store?retryWrites=true&w=majority
#
# Option B: Local MongoDB (if running locally or in Docker)
# Example: MONGODB_URI=mongodb://127.0.0.1:27017/mrsm_store
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/mrsm_store
